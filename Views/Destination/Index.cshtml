@model List<Project3Vitour.Dtos.DestinationDtos.ResultDestinationDto>
@{
    ViewData["Title"] = "Destinasyon Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<div class="container-fluid pt-4 px-4">
    @* Üst Başlık Kartı *@
    <div class="card border-0 shadow-sm mb-4 rounded-4" style="background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);">
        <div class="card-body p-4 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <div style="background: rgba(255,255,255,0.2); width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(5px);">
                    <i class="bi bi-geo-alt-fill text-white fs-3"></i>
                </div>
                <div class="ms-3">
                    <h4 class="fw-bold text-white m-0">Destinasyon Yönetimi</h4>
                    <p class="text-white text-opacity-75 m-0 small">Tur rotalarını ve lokasyon bilgilerini buradan yönetin.</p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="/Destination/ExportToExcel" class="btn btn-success fw-bold rounded-3 px-3 py-2 shadow-sm">
                    <i class="bi bi-file-earmark-excel me-1"></i> Excel Raporu
                </a>
                <a href="/Destination/ImportFromTours" class="btn btn-warning fw-bold rounded-3 px-3 py-2 shadow-sm">
                    <i class="bi bi-arrow-repeat me-1"></i> Turlardan Veri Çek
                </a>
                <a href="/Destination/CreateDestination" class="btn btn-light fw-bold rounded-3 px-4 py-2 shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Yeni Rota Ekle
                </a>
            </div>
        </div>
    </div>

    @* Liste Kartı *@
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 text-muted small text-uppercase" style="width: 50px;">#</th>
                            <th class="py-3 text-muted small text-uppercase">Rota / Şehir</th>
                            <th class="py-3 text-muted small text-uppercase">Fiyat</th>
                            <th class="py-3 text-muted small text-uppercase">Kapasite</th>
                            <th class="py-3 text-muted small text-uppercase">Süre</th>
                            <th class="py-3 text-muted small text-uppercase text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            count++;
                            <tr>
                                <td class="ps-4 fw-bold text-muted">@count</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@item.ImageUrl" class="rounded-3 shadow-sm me-3" style="width: 60px; height: 45px; object-fit: cover; border: 2px solid #f1f5f9;">
                                        <div>
                                            <div class="fw-bold text-dark">@item.City</div>
                                            <div class="text-muted small">@item.Country</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge rounded-pill bg-soft-primary text-primary fw-bold" style="background: #eef2ff; color: #4f46e5 !important; font-size: 13px;">@item.Price.ToString("C2")</span></td>
                                <td><i class="bi bi-people me-2 text-muted"></i>@item.Capacity Kişi</td>
                                <td><i class="bi bi-clock me-2 text-muted"></i>@item.DayNight</td>
                                <td class="text-end pe-4">
                                    <a href="/Destination/UpdateDestination/@item.DestinationId" class="btn btn-sm btn-outline-primary rounded-3 me-2">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="javascript:void(0)"
                                       onclick="deleteDestination('@item.DestinationId')"
                                       class="btn btn-sm btn-outline-danger rounded-3">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    /*Tüm sayfa yapısını dikeyde ekranı kaplayacak şekilde zorla */
    html, body {
        height: 100%;
        margin: 0;
    }

    /* Ana içerik alanını (sağ tarafı) sidebar ile aynı boya getir */
    .container-fluid.pt-4.px-4 {
        min-height: calc(100vh - 20px); /* Üstteki boşluğu hesaba katarak tam ekran boyu */
        display: flex;
        flex-direction: column;
        padding-bottom: 20px; /* En altta sidebar ile sıfırlanması için */
    }

    /* Tablo Kartını (Liste Kartı) aşağı doğru esnet */
    .card.border-0.shadow-sm.rounded-4:last-child {
        flex: 1; /* Mevcut dikey boşluğun tamamını doldurur */
        display: flex;
        flex-direction: column;
        margin-bottom: 0 !important; /* Sidebar ile hizayı bozmaması için alttaki margin'i sıfırla */
    }

    /* Kartın içeriğini (tabloyu) kartın içine yay */
    .card-body.p-0 {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    /* DataTables wrapper'ını en alta kadar uzat */
    .dataTables_wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between; /* Tabloyu orta, pagination'ı en alta iter */
        padding: 20px !important;
    }

    /* Tablo alanı çok yer kaplaması için */
    .table-responsive {
        flex: 1;
    }
</style>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

<script src="https://code.jquery.com/jquery-3.7.0.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // jQuery Çakışmasını Engellemek İçin Özel Değişken
    var $dt = jQuery.noConflict(true);

    $dt(document).ready(function () {
        // DataTables Kurulumu
        if ($dt.fn.DataTable.isDataTable('.table')) {
            $dt('.table').DataTable().destroy(); // Varsa önce eskisini öldür
        }

        $dt('.table').DataTable({
            "pageLength": 10,
            "lengthMenu": [10, 25, 50],
            "ordering": true,
            "language": {
                "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json"
            },
            "dom": '<"d-flex justify-content-between align-items-center mb-3"lf>rt<"d-flex justify-content-between align-items-center mt-3"ip>'
        });
    });

    // Silme Fonksiyonu (SweetAlert)
    function deleteDestination(id) {
        Swal.fire({
            title: 'Emin misiniz?',
            text: "Bu rotayı sildiğinizde geri alamazsınız!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#4f46e5',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Evet, sil!',
            cancelButtonText: 'Vazgeç',
            customClass: { popup: 'rounded-4' }
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = "/Destination/DeleteDestination/" + id;
            }
        });
    }
</script>