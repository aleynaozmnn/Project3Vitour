@model List<Project3Vitour.Dtos.TourDto.ResultTourDto>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <style>
        /* Senin mevcut CSS kodların */
        .ap-stat-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 24px;
            padding: 32px;
            height: 100%;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .ap-stat-card:hover {
                transform: translateY(-8px);
                border-color: #4f46e5 !important;
                box-shadow: 0 15px 35px rgba(79, 70, 229, 0.08) !important;
            }

        .ap-icon-circle {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            transition: all 0.3s ease;
        }

        .progress {
            background-color: #f1f5f9;
            border-radius: 10px;
            overflow: hidden;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(79, 70, 229, 0.03) !important;
            box-shadow: inset 4px 0 0 #4f46e5;
        }

        .btn-light.border:hover {
            background-color: #4f46e5 !important;
            color: white !important;
        }

        /* Tabloyu Sınırlayan Konteyner (Revize Edilen Kısım) */
        .table-scroll-container {
            max-height: 500px;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #cbd5e1 transparent;
        }

            /* Başlıkları Kaydırırken Sabit Tutma */
            .table-scroll-container thead {
                position: sticky;
                top: 0;
                z-index: 10;
                background: white;
            }

            /* Scrollbar tasarımı */
            .table-scroll-container::-webkit-scrollbar {
                width: 6px;
            }

            .table-scroll-container::-webkit-scrollbar-thumb {
                background-color: #cbd5e1;
                border-radius: 10px;
            }
    </style>
}

@* 1. PATRON BANNER *@
<div class="boss-banner" style="background: white; border-radius: 24px; padding: 32px; border: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
    <div class="d-flex align-items-center">
        <div style="width: 64px; height: 64px; background: #eff6ff; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; color: #2563eb; margin-right: 24px;">
            <i class="bi bi-grid-1x2-fill"></i>
        </div>
        <div>
            <h1 class="fw-bold m-0" style="letter-spacing: -1.5px; font-size: 28px;">Patron Yönetim Paneli</h1>
            <p class="text-muted m-0">Finansal özet ve tur doluluk analizlerini buradan takip edin.</p>
        </div>
    </div>
    <a href="/AdminTour/CreateTour" class="btn btn-dark fw-bold px-4 py-2" style="border-radius: 12px; height: fit-content;">
        <i class="bi bi-plus-lg me-2"></i> Yeni Tur Ekle
    </a>
</div>

@* 2. DİNAMİK İSTATİSTİK KARTLARI *@
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="ap-stat-card">
            <div class="ap-icon-circle" style="background: #ecfdf5; color: #10b981;">
                <i class="bi bi-cash-stack fs-4"></i>
            </div>
            <div class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Toplam Tahmini Kazanç</div>
            <h2 class="fw-bold m-0 mt-1" style="font-size: 32px;">₺@ViewBag.TotalEarning.ToString("N0")</h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ap-stat-card">
            <div class="ap-icon-circle" style="background: #eff6ff; color: #3b82f6;">
                <i class="bi bi-people-fill fs-4"></i>
            </div>
            <div class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Toplam Aktif Yolcu</div>
            <h2 class="fw-bold m-0 mt-1" style="font-size: 32px;">@ViewBag.TotalTravelers</h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ap-stat-card">
            <div class="ap-icon-circle" style="background: #fff7ed; color: #f97316;">
                <i class="bi bi-pie-chart-fill fs-4"></i>
            </div>
            <div class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Genel Doluluk Oranı</div>
            <h2 class="fw-bold m-0 mt-1" style="font-size: 32px;">%@ViewBag.AvgFullness</h2>
        </div>
    </div>
</div>

@* 3. TABLO (Dinamik Doluluk Analizi) *@
<div class="bg-white border rounded-4 p-4 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold m-0">Tur Bazlı Kontenjan Analizi</h4>
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill small">Toplam @ViewBag.TotalTours Destinasyon</span>
    </div>

    @* SARMALAYICI DIV BURAYA EKLENDİ *@
    <div class="table-scroll-container">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="text-muted small">
                    <tr>
                        <th class="border-0">DESTİNASYON</th>
                        <th class="border-0">BİRİM FİYAT</th>
                        <th class="border-0">KONTENJAN</th>
                        <th class="border-0" style="width: 30%;">DOLULUK</th>
                        <th class="border-0 text-end">İŞLEM</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        double occupancyRate = item.Capacity > 0
                        ? (double)item.CurrentReservationCount / item.Capacity * 100
                        : 0;

                        <tr>
                            <td class="py-3">
                                <div class="fw-bold text-dark">@item.Title</div>
                                <div class="text-muted" style="font-size: 11px;">@item.Badge</div>
                            </td>
                            <td class="fw-bold text-primary">₺@item.Price.ToString("N0")</td>
                            <td class="small fw-bold">@item.CurrentReservationCount / @item.Capacity</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="progress w-100" style="height: 8px;">
                                        <div class="progress-bar @(occupancyRate >= 90 ? "bg-danger" : (occupancyRate >= 50 ? "bg-primary" : "bg-success"))"
                                             role="progressbar"
                                             style="width: @occupancyRate.ToString("0")%"></div>
                                    </div>
                                    <span class="small fw-bold text-muted">%@occupancyRate.ToString("0")</span>
                                </div>
                            </td>
                            <td class="text-end">
                                <a href="/AdminTour/UpdateTour/@item.TourId" class="btn btn-sm btn-light border fw-bold px-3" style="border-radius: 8px;">Detay</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            var message = '@Html.Raw(TempData["SuccessMessage"])';
            if (message) {
                Swal.fire({
                    title: 'Harika!',
                    text: message,
                    icon: 'success',
                    confirmButtonColor: '#4f46e5'
                });
            }
        });
    </script>
}