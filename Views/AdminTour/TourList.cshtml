@model List<ResultTourDto>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Tur Paketleri Yönetimi";
}

@section Styles {
    <style>
        /* Görsel ve Statü Tasarımları */
        .ap-tour-img {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            object-fit: cover;
        }

        .ap-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
            text-decoration: none !important;
        }

        .status-live {
            background: rgba(16,185,129,.1);
            color: #10b981;
        }

        .status-draft {
            background: #f1f5f9;
            color: #64748b;
        }

        .ap-status:hover {
            transform: scale(1.05);
        }

        /* Kart ve Tablo Hover Efektleri (Mavi Tema) */
        .col-md-4 .bg-white {
            transition: all 0.3s ease;
            border: 1px solid #e2e8f0;
        }

            .col-md-4 .bg-white:hover {
                transform: translateY(-5px);
                border-color: #4f46e5 !important;
                box-shadow: 0 10px 20px rgba(79, 70, 229, 0.05) !important;
            }

        .table-hover tbody tr {
            transition: all 0.2s ease;
        }

            .table-hover tbody tr:hover {
                background-color: rgba(79, 70, 229, 0.04) !important;
                box-shadow: inset 4px 0 0 #4f46e5;
            }

        /* Filtreleme Paneli Stilleri */
        .search-wrapper {
            position: relative;
        }

            .search-wrapper i {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #94a3b8;
            }

        .search-input {
            padding-left: 45px !important;
            border-radius: 12px !important;
            border: 1px solid #e2e8f0;
            height: 48px;
        }

        .filter-label {
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            margin-bottom: 8px;
            display: block;
            letter-spacing: 0.5px;
        }
        /* DataTables Sayfalamayı Güzelleştirme */
        .dataTables_length {
            margin: 0 !important;
        }

            .dataTables_length label {
                font-size: 13px !important;
                font-weight: 600 !important;
                color: #64748b !important;
                display: flex !important;
                align-items: center !important;
                gap: 10px !important;
                margin: 0 !important;
            }

            .dataTables_length select {
                appearance: none;
                background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
                background-repeat: no-repeat;
                background-position: right 0.5rem center;
                background-size: 1.5em 1.5em;
                padding: 0.4rem 2rem 0.4rem 0.8rem !important;
                border: 1px solid #e2e8f0 !important;
                border-radius: 10px !important;
                font-size: 13px !important;
                cursor: pointer !important;
                outline: none !important;
                transition: all 0.2s;
            }

                .dataTables_length select:focus {
                    border-color: #4f46e5 !important;
                    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1) !important;
                }
    </style>
}

<div class="boss-banner" style="background: white; border-radius: 24px; padding: 24px 32px; border: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
    <div class="d-flex align-items-center">
        <div class="banner-icon-box" style="width: 56px; height: 56px; background: #f1f0ff; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: #4f46e5; margin-right: 20px;">
            <i class="bi bi-map-fill"></i>
        </div>
        <div>
            <h2 class="fw-bold m-0" style="letter-spacing: -1px;">Tur Paketleri</h2>
            <p class="text-muted m-0 small">Sistemdeki turları buradan yönetebilirsiniz.</p>
        </div>
    </div>
    <a href="/AdminTour/CreateTour" class="btn btn-dark fw-bold px-4 py-2" style="border-radius: 12px;">
        <i class="bi bi-plus-lg me-2"></i> Yeni Tur Ekle
    </a>
</div>

@* 2. GELİŞMİŞ FİLTRELEME PANELİ *@
<div class="row g-3 mb-4 align-items-end">
    <div class="col-md-4">
        <label class="filter-label">Tur Adı veya ID</label>
        <div class="search-wrapper shadow-sm">
            <i class="bi bi-search"></i>
            <input type="text" id="nameFilter" class="form-control search-input" placeholder="Arama yapın...">
        </div>
    </div>

    <div class="col-md-3">
        <label class="filter-label">Kategori (Rozet)</label>
        <select id="categoryFilter" class="form-select shadow-sm" style="border-radius: 12px; height: 48px;">
            <option value="">Tüm Kategoriler</option>
            @if (ViewBag.CategoryList != null)
            {
                foreach (var categoryName in (List<string>)ViewBag.CategoryList)
                {
                    <option value="@categoryName">@categoryName</option>
                }
            }
        </select>
    </div>

    <div class="col-md-3">
        <label class="filter-label">Maksimum Fiyat (₺)</label>
        <input type="number" id="priceFilter" class="form-control shadow-sm" style="border-radius: 12px; height: 48px;" placeholder="Örn: 30000">
    </div>

    <div class="col-md-2">
        <button id="resetFilters" class="btn btn-outline-secondary w-100 fw-bold" style="border-radius: 12px; height: 48px;">
            <i class="bi bi-arrow-counterclockwise me-1"></i> Sıfırla
        </button>
    </div>
</div>

@* 3. İSTATİSTİK KARTLARI *@
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="p-4 bg-white rounded-4 shadow-sm text-center text-md-start">
            <div class="text-muted small fw-bold">TOPLAM TUR</div>
            <h2 class="fw-bold m-0">@Model.Count</h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-4 bg-white rounded-4 shadow-sm text-center text-md-start">
            <div class="text-muted small fw-bold text-success">AKTİF TURLAR</div>
            <h2 class="fw-bold m-0 text-success">@Model.Count(x => x.IsStatus)</h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-4 bg-white rounded-4 shadow-sm text-center text-md-start">
            <div class="text-muted small fw-bold text-warning">ORTALAMA FİYAT</div>
            <h2 class="fw-bold m-0 text-warning">@(Model.Any() ? Model.Average(x => (double)x.Price).ToString("N0") : "0")₺</h2>
        </div>
    </div>
</div>

@* 4. TABLO *@
<div class="bg-white border rounded-4 overflow-hidden shadow-sm">
    <table class="table table-hover align-middle m-0" id="tourTable">
        <thead class="bg-light text-muted small text-uppercase">
            <tr>
                <th class="ps-4 py-3">Tur Bilgisi</th>
                <th>Kategori</th>
                <th>Rozet</th>
                <th>Fiyat</th>
                <th>Durum</th>
                <th class="text-end pe-4">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="ps-4">
                        <div class="d-flex align-items-center gap-3">
                            <img src="@item.CoverImageUrl" class="ap-tour-img" onerror="this.src='https://placehold.co/100x100?text=Tur'">
                            <div>
                                <div class="fw-bold text-dark">@item.Title</div>
                                <div class="text-muted extra-small" style="font-size: 11px;">ID: @item.TourId</div>
                            </div>
                        </div>
                    </td>

                    <td><span class="text-muted small">@item.CategoryName</span></td>

                    <td>
                        @if (!string.IsNullOrEmpty(item.Badge))
                        {
                            <span class="badge bg-light text-primary border">@item.Badge.Trim()</span>
                        }
                        else
                        {
                            <span class="text-muted small">---</span>
                        }
                    </td>

                    <td class="fw-bold text-indigo" data-order="@item.Price">₺@item.Price.ToString("N0")</td>

                    <td>
                        <a href="/AdminTour/ChangeStatus/@item.TourId" class="ap-status @(item.IsStatus ? "status-live" : "status-draft")">
                            <i class="bi bi-circle-fill" style="font-size: 8px;"></i>
                            @(item.IsStatus ? "Aktif" : "Pasif")
                        </a>
                    </td>

                    <td class="text-end pe-4">
                        <div class="btn-group">
                            <a href="/AdminTour/UpdateTour/@item.TourId" class="btn btn-sm btn-outline-primary" title="Düzenle"><i class="bi bi-pencil"></i></a>
                            <a href="/AdminTour/AddImage/@item.TourId" class="btn btn-sm btn-outline-info" title="Resimler"><i class="bi bi-image"></i></a>
                            <a href="/AdminTour/DeleteTour/@item.TourId" class="btn btn-sm btn-outline-danger" title="Sil" onclick="return confirm('Silmek istediğinize emin misiniz?')"><i class="bi bi-trash"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // 1. ÖZEL FİLTRELEME: Fiyat aralığı için DataTables'a kural ekliyoruz
        $.fn.dataTable.ext.search.push(
            function(settings, data, dataIndex) {
                // Input ID'si senin kodunda priceFilter, o yüzden buradan çekiyoruz
                var max = parseInt($('#priceFilter').val(), 10);

                // Tablodaki 2. indexli sütun (Fiyat). ₺ ve . karakterlerini silip sayıya çeviriyoruz.
                var price = parseFloat(data[3].replace(/[^\d]/g, '')) || 0;

                if (isNaN(max) || price <= max) {
                    return true;
                }
                return false;
            }
        );

        $(document).ready(function () {
            // Tabloyu başlat
            var table = $('#tourTable').DataTable({
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true,
                "pageLength": 10,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json"
                },
                "dom": '<"row px-4 py-3 align-items-center"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rt<"row px-4 py-3 align-items-center"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
            });

            // İsim Filtresi
            $("#nameFilter").on("keyup", function () {
                table.column(0).search(this.value).draw();
            });

                    // Kategori Filtresi Kısmı
                // Kategori Dropdown Değiştiğinde
        $("#categoryFilter").on("change", function () {
            var val = $(this).val();

            if (val === "") {
                // Eğer "Tüm Kategoriler" seçilirse filtreyi temizle
                table.column(1).search('').draw();
            } else {
                // Sadece Kategori sütununda (index 1) tam eşleşme ara
                // regex: true ve smart: false yaparak tam metni aratıyoruz
                table.column(1).search(val).draw();
            }
        });
            // Fiyat Filtresi Tetikleyici
            $('#priceFilter').on('keyup change', function () {
                table.draw();
            });

            // Filtreleri Sıfırla
            $("#resetFilters").click(function () {
                $("#nameFilter, #priceFilter, #categoryFilter").val("");
                $("#categoryFilter").val("");
                table.search('').columns().search('').draw();
            });

            // Başarı Mesajı
            @if (TempData["SuccessMessage"] != null)
            {
                    <text>
                    Swal.fire({
                        title: 'Başarılı!',
                        text: '@TempData["SuccessMessage"]',
                        icon: 'success',
                        confirmButtonColor: '#4f46e5'
                    });
                    </text>
            }
        });
    </script>
}