@model Project3Vitour.Dtos.ImageDtos.CreateTourImageDto

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Tur Resim Yönetimi";
    var currentImages = ViewBag.CurrentImages as List<Project3Vitour.Dtos.ImageDtos.ResultTourImageDto> ?? new List<Project3Vitour.Dtos.ImageDtos.ResultTourImageDto>();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0">Tur Resim Galerisi (Maks. 6)</h2>
        <a href="/AdminTour/TourList" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Listeye Dön
        </a>
    </div>

    @* RESİM EKLEME FORMU *@
    <div class="card shadow-sm border-0 mb-5 p-4" style="border-radius: 15px;">
        <h5 class="fw-bold mb-3">Yeni Resim Ekle</h5>
        <form method="post" asp-action="AddImage" asp-controller="AdminTour">
            <input type="hidden" asp-for="TourId" />
            <div class="input-group">
                <input type="text" asp-for="ImageUrl" class="form-control" placeholder="Resim URL'sini buraya yapıştırın..." required>
                <button class="btn btn-dark px-4" type="submit">
                    <i class="bi bi-plus-lg"></i> Galeriye Ekle
                </button>
            </div>
        </form>
    </div>

    @* SABİT 6 KARTLI GALERİ *@
    <div class="row g-4">
        @for (int i = 0; i < 6; i++)
        {
            var img = currentImages.ElementAtOrDefault(i);

            <div class="col-md-4">
                <div class="card h-100 shadow-sm" style="border-radius: 12px; overflow: hidden; border: 2px dashed @(img == null ? "#dee2e6" : "transparent");">
                    @if (img != null)
                    {
                        @* SLOT DOLU *@
                        <div style="position: relative;">
                            <img src="@img.ImageUrl" class="card-img-top" style="height: 220px; object-fit: cover;">
                            <div class="badge bg-success" style="position: absolute; top: 10px; right: 10px;">Dolu</div>
                        </div>
                        <div class="card-body text-center bg-white">
                            <h6 class="text-muted small mb-3">Slot @(i + 1)</h6>
                            <a href="/AdminTour/DeleteImage/@img.Id" class="btn btn-sm btn-danger w-100 py-2" onclick="return confirm('Bu resmi silmek istediğinize emin misiniz?')">
                                <i class="bi bi-trash"></i> Resmi Kaldır
                            </a>
                        </div>
                    }
                    else
                    {
                        @* SLOT BOŞ *@
                        <div class="card-body d-flex flex-column align-items-center justify-content-center" style="height: 310px; background: #f8f9fa;">
                            <div class="mb-3 text-center">
                                <i class="bi bi-image text-muted" style="font-size: 3rem; opacity: 0.2;"></i>
                            </div>
                            <p class="text-muted fw-bold mb-1">Boş Slot @(i + 1)</p>
                            <p class="text-muted extra-small" style="font-size: 12px;">Henüz resim eklenmedi</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>