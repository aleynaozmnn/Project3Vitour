@model Project3Vitour.Dtos.ReservationDto.ResultReservationDto
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Rezervasyon Detayı";
}

<style>
    .detail-card {
        background: #ffffff;
        border-radius: 30px;
        border: 1px solid #edf2f7;
        box-shadow: 0 10px 25px rgba(0,0,0,0.02);
        overflow: hidden;
    }

    .info-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 20px;
        transition: all 0.3s ease;
    }

        .info-box:hover {
            background: #ffffff;
            border-color: #4f46e5;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.08);
        }

    .label-text {
        font-size: 11px;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
        display: block;
    }

    .value-text {
        font-size: 16px;
        font-weight: 600;
        color: #1e293b;
    }

    .status-badge {
        background: #eef2ff;
        color: #4f46e5;
        padding: 8px 16px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 13px;
    }

    .header-gradient {
        background: linear-gradient(90deg, #4f46e5 0%, #7c3aed 100%);
        padding: 40px;
        color: white;
    }
</style>

<div class="content-wrapper p-4">
    <div class="container">
        <div class="detail-card">
            <div class="header-gradient d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold m-0 text-white">Rezervasyon Bilgileri</h2>
                    <p class="m-0 text-white-50 mt-1">#@Model.ReservationId numaralı kayıt detayları</p>
                </div>
                <a href="/AdminTour/ReservationList" class="btn btn-white btn-sm px-4 rounded-pill bg-white text-primary fw-bold border-0 shadow-sm">
                    <i class="bi bi-arrow-left me-2"></i>Listeye Dön
                </a>
            </div>

            <div class="card-body p-5">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="info-box h-100">
                            <span class="label-text">Müşteri</span>
                            <div class="d-flex align-items-center">
                                <div style="width: 45px; height: 45px; background: #4f46e5; color: white; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-weight: bold; margin-right: 15px;">
                                    @Model.NameSurname.Substring(0, 1).ToUpper()
                                </div>
                                <div class="value-text fs-5">@Model.NameSurname</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="info-box h-100" style="border-left: 4px solid #f59e0b;">
                            <span class="label-text">Rezerve Edilen Tur</span>
                            <div class="value-text text-warning">
                                <i class="bi bi-geo-alt-fill me-2"></i>@Model.Description
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="info-box">
                            <span class="label-text">E-Posta</span>
                            <div class="value-text"><i class="bi bi-envelope me-2 text-muted"></i>@Model.Email</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-box">
                            <span class="label-text">Telefon</span>
                            <div class="value-text"><i class="bi bi-telephone me-2 text-muted"></i>@Model.Phone</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-box text-center">
                            <span class="label-text">Kişi Sayısı</span>
                            <span class="status-badge">@Model.PersonCount Kişi</span>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="p-4 rounded-4 bg-light d-flex align-items-center justify-content-between border border-dashed">
                            <div>
                                <span class="label-text">Planlanan Tarih</span>
                                <div class="value-text fs-5"><i class="bi bi-calendar-check me-2"></i>@Model.ReservationDate.ToString("dd MMMM yyyy, dddd")</div>
                            </div>
                            <div class="text-end">
                                <span class="label-text">Sistem Kayıt ID</span>
                                <code class="small text-muted">@Model.TourId</code>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-5 d-flex gap-3">
                    <a href="/AdminTour/ExportToExcel/@Model.ReservationId" class="btn btn-success btn-lg rounded-pill px-5 shadow-sm fw-bold border-0">
                        <i class="bi bi-file-earmark-spreadsheet me-2"></i>Excel Raporu
                    </a>
                    <button onclick="window.print()" class="btn btn-outline-primary btn-lg rounded-pill px-5 shadow-sm fw-bold border-2">
                        <i class="bi bi-printer me-2"></i>Yazdır
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>