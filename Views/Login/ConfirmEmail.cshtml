@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <title>Giriş Onayı</title>
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-4 card p-4 shadow-sm text-center">
                <h3 class="mb-3">Onay Kodu</h3>
                <p class="text-muted small">Lütfen e-posta adresinize gönderilen 6 haneli kodu aşağıya giriniz.</p>

                <form asp-controller="Login" asp-action="ConfirmEmail" method="post">
                    <div class="form-group mb-3">
                        <input type="text" name="code" class="form-control text-center form-control-lg"
                               placeholder="000000" maxlength="6" required autocomplete="off"
                               style="font-size: 24px; letter-spacing: 8px; font-weight: bold;">
                    </div>

                    <button type="submit" class="btn btn-primary w-100 btn-lg">Doğrula ve Giriş Yap</button>
                </form>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mt-3">
                        @ViewBag.Error
                    </div>
                }
            </div>
        </div>
    </div>
</body>
</html>