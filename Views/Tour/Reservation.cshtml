@model Project3Vitour.Dtos.ReservationDto.CreateReservationDto
@{
    Layout = null;
    // Güvenli hesaplama: null gelirse 0 kabul et
    int capacity = ViewBag.Capacity ?? 0;
    int bookings = ViewBag.CurrentBookings ?? 0;
    int remainingCapacity = capacity - bookings;

    // JS için sayı formatını hazırla (1500.00 gibi)
    string jsPrice = ((decimal)(ViewBag.Price ?? 0)).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vitour – @ViewBag.TourName Rezervasyonu</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        :root {
            --green-deep: #0b3d2e;
            --green-mid: #165c44;
            --green-accent: #22c98a;
            --sand: #f5f0e8;
            --text-main: #1a1a1a;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: var(--sand);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        .serif {
            font-family: 'Cormorant Garamond', serif;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(24px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-up {
            animation: fadeUp 0.7s ease both;
        }

        .fade-up-1 {
            animation-delay: 0.1s;
        }

        .fade-up-2 {
            animation-delay: 0.2s;
        }

        .left-panel {
            background: linear-gradient(160deg, #0b3d2e 0%, #145240 45%, #1e7358 100%);
            position: relative;
            overflow: hidden;
            color: white;
        }

        .glass-badge {
            background: rgba(255,255,255,0.12);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.18);
        }

        .stat-row {
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .field-input {
            width: 100%;
            padding: 0.75rem 1rem;
            border-radius: 0.875rem;
            border: 1.5px solid #e2ddd4;
            background: #fdfcfa;
            outline: none;
            transition: all 0.2s;
        }

            .field-input:focus {
                border-color: #22c98a;
                box-shadow: 0 0 0 4px rgba(34, 201, 138, 0.15);
            }

        .btn-submit {
            background: linear-gradient(135deg, #0f5c40 0%, #1a8c61 100%);
            color: #fff;
            border-radius: 0.875rem;
            padding: 1rem;
            width: 100%;
            font-weight: 500;
            cursor: pointer;
            transition: transform 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            box-shadow: 0 10px 20px rgba(15, 92, 64, 0.2);
        }

            .btn-submit:hover {
                transform: translateY(-2px);
            }

        .pulse {
            animation: pulse 2s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: 0.5;
            }
        }
    </style>
</head>
<body>

    <div class="w-full max-w-5xl fade-up fade-up-1">
        <div class="text-center mb-8">
            <span class="serif text-4xl font-semibold tracking-wide" style="color:var(--green-deep);">Vitour</span>
            <p class="text-[10px] font-medium mt-1 text-gray-400 uppercase tracking-[0.3em]">Premium Travel Experience</p>
        </div>

        <div class="flex flex-col md:flex-row rounded-[2rem] overflow-hidden shadow-2xl bg-white min-h-[650px]">

            <div class="left-panel md:w-[42%] p-8 lg:p-10 flex flex-col justify-between fade-up fade-up-2">
                <div>
                    <div class="flex items-center justify-between mb-8">
                        <div class="w-12 h-12 rounded-2xl flex items-center justify-center glass-badge">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-green-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <span class="glass-badge text-[10px] uppercase tracking-widest font-bold px-3 py-1.5 rounded-lg" style="color:#a8f0d1;">
                            ✦ Popüler Tur
                        </span>
                    </div>

                    <h2 class="serif font-semibold leading-tight mb-4" style="font-size:2.4rem;">
                        @ViewBag.TourName
                    </h2>

                    <p class="text-sm font-light leading-relaxed mb-8" style="color:rgba(255,255,255,0.7); border-left: 2px solid rgba(34, 201, 138, 0.4); padding-left: 1rem;">
                        Kültür, tarih ve doğanın buluştuğu bu eşsiz rotada unutulmaz anılar biriktirmek için yerinizi ayırtın.
                    </p>
                </div>

                <div class="space-y-1">
                    <div class="stat-row flex justify-between items-center py-4">
                        <div class="flex items-center gap-3 text-sm opacity-60">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                            Başlangıç
                        </div>
                        <span class="text-sm font-medium">Tur Detayında Belirtilen</span>
                    </div>

                    <div class="stat-row flex justify-between items-center py-4">
                        <div class="flex items-center gap-3 text-sm opacity-60">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            Kontenjan
                        </div>
                        <span class="text-sm font-medium flex items-center gap-2">
                            <span class="pulse w-2 h-2 rounded-full inline-block" style="background:#22c98a;"></span>
                            @ViewBag.CurrentBookings / @ViewBag.Capacity Kişi
                        </span>
                    </div>

                    <div class="flex justify-between items-center pt-8">
                        <span class="text-xs uppercase tracking-widest opacity-50">Kişi Başı Fiyat</span>
                        <span class="serif text-4xl font-semibold" style="color:#a8f0d1;">₺@ViewBag.Price.ToString("N0")</span>
                    </div>
                </div>
            </div>

            <div class="bg-white md:w-[58%] p-8 lg:p-12">

                @if (remainingCapacity <= 0)
                {
                    <div class="h-full flex flex-col items-center justify-center text-center space-y-6">
                        <div class="w-20 h-20 bg-red-50 rounded-full flex items-center justify-center mb-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h3 class="serif text-3xl font-bold text-gray-900">Kontenjanımız Doldu</h3>
                        <p class="text-gray-500 max-w-sm">Maalesef bu tur için tüm yerler tükendi. Benzer turlarımız için listeye geri dönebilirsiniz.</p>
                        <a href="/Tour/TourList" class="btn-submit !bg-gray-900 !shadow-none" style="background: #1a1a1a;">Tüm Turları Gör</a>
                    </div>
                }
                else
                {
                    <div class="flex items-start gap-3 rounded-2xl px-5 py-4 mb-10" style="background:#fffbeb; border:1px solid #fde68a;">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <p class="text-sm text-amber-800 leading-tight">
                            Son <strong>@remainingCapacity</strong> kişilik kontenjan! Hemen yerinizi ayırtın.
                        </p>
                    </div>

                    <form id="reservationForm" method="post" class="space-y-6">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TourId" value="@ViewBag.TourId" />

                        <div class="space-y-4">
                            <div>
                                <label class="block text-[10px] font-bold mb-2 uppercase text-gray-400 tracking-wider">Ad Soyad Bilgisi</label>
                                <input type="text" name="NameSurname" required class="field-input" placeholder="Örn: Ahmet Yılmaz" />
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-[10px] font-bold mb-2 uppercase text-gray-400 tracking-wider">E-posta</label>
                                    <input type="email" name="Email" required class="field-input" placeholder="mail@adresiniz.com" />
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold mb-2 uppercase text-gray-400 tracking-wider">Telefon</label>
                                    <input type="tel" name="Phone" required class="field-input" placeholder="05xx xxx xx xx" />
                                </div>
                            </div>

                            <div>
                                <label class="block text-[10px] font-bold mb-2 uppercase text-gray-400 tracking-wider">Kişi Sayısı</label>
                                <input type="number" id="PersonCount" name="PersonCount" min="1" max="@remainingCapacity" value="1" required class="field-input" />
                            </div>


                            <div id="extraParticipantsArea" style="display:none;" class="mt-4">
                                <label class="block text-[10px] font-bold mb-2 uppercase text-gray-400 tracking-wider">Ek Katılımcı Bilgileri</label>
                                <textarea id="descriptionInput" name="Description" class="field-input h-24 resize-none"
                                      placeholder="Diğer misafirlerin ad-soyad bilgilerini buraya yazabilirsiniz..."></textarea>
                                <p class="text-[10px] text-emerald-600 mt-1 italic">Birden fazla kişi seçtiğiniz için bu alan aktifleşti.</p>
                            </div>
                        </div>

                        <div class="flex justify-between items-center rounded-2xl px-6 py-5 mt-8" style="background:#fcfaf7; border:1px solid #f0ede8;">
                            <div>
                                <p class="text-[10px] font-bold uppercase text-gray-400 mb-1">Tahmini Ödeme</p>
                                <p class="text-sm font-medium text-gray-700"><span id="displayCount">1</span> x ₺@ViewBag.Price.ToString("N0")</p>
                            </div>
                            <div class="text-right">
                                <p class="serif text-3xl font-bold text-emerald-900" id="totalPrice">₺@ViewBag.Price.ToString("N0")</p>
                            </div>
                        </div>

                        <button type="submit" class="btn-submit mt-4">
                            Rezervasyonu Onayla
                        </button>
                    </form>
                }
            </div>
        </div>
        <p class="text-center text-[10px] text-gray-400 mt-8 tracking-widest uppercase">© 2026 Vitour · Luxury Travel Agency</p>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
                 $(document).ready(function () {
            
            const unitPrice = parseFloat("@jsPrice");
            const remaining = parseInt("@remainingCapacity");

                    $('#PersonCount').on('input change', function () {
            let count = parseInt($(this).val());

           
            if (count > 1) {
                $('#extraParticipantsArea').slideDown(); // 1'den fazlaysa alanı göster
            } else {
                $('#extraParticipantsArea').slideUp();   // 1 ise alanı gizle
                $('#descriptionInput').val("");          // Gizlendiğinde içini temizle
            }
             

            if (count > remaining) {
                $(this).val(remaining);
                count = remaining;
            }
            if (isNaN(count) || count < 1) count = 1;

            const total = count * unitPrice;
            $('#displayCount').text(count);
            $('#totalPrice').text('₺' + total.toLocaleString('tr-TR', { minimumFractionDigits: 2 }));
        });

            $('#reservationForm').on('submit', function (e) {
                e.preventDefault();

                
                $.ajax({
                    type: 'POST',
                    url: '/Tour/MakeReservation', // URL'i doğrudan yazdık
                    data: $(this).serialize(),
                    success: function (res) {
                        if (res.success) {
                            Swal.fire({
                                title: 'Başarılı!',
                                text: res.message,
                                icon: 'success',
                                confirmButtonColor: '#165c44'
                            }).then(() => {
                                window.location.href = '/Tour/TourList';
                            });
                        } else {
                            Swal.fire('Hata!', res.message, 'error');
                        }
                    }
                });
            });
        });
    </script>
</body>
</html>