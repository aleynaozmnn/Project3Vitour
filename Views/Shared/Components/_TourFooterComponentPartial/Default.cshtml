@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<Project3Vitour.SharedResource> SharedLocalizer
@inject IViewLocalizer Localizer
<footer class="footer footer-style1">
    <div class="tf-container">
        <div class="footer-main">

            <!-- LOGO -->
            <div class="footer-logo">
                <div class="logo-footer">
                    <img src="/vitour/assets/images/logo2.png" alt="">
                </div>

                <p class="des-footer">
                    @SharedLocalizer["Footer_Description"]
                </p>

                <ul class="footer-info">
                    <li><p>Info@vitour.com</p></li>
                    <li><p>+90 212 555 01 02</p></li>
                    <li><p>@SharedLocalizer["Footer_Address"]</p></li>
                </ul>
            </div>

            <!-- KURUMSAL -->
            <div class="footer-service">
                <h5 class="title">@SharedLocalizer["Footer_QuickLinks"]</h5> <ul class="footer-menu">
                    <li><a href="#">@SharedLocalizer["Footer_AboutTitle"]</a></li>
                    <li><a href="#">@SharedLocalizer["Tab_Gallery"]</a></li>
                    <li><a href="#">@SharedLocalizer["Footer_Contact"]</a></li>
                </ul>
            </div>

            <div class="footer-gallery">
                <h5 class="title">@Localizer["Gallery"]</h5>

                <div class="gallery-img">
                    <a href="https://images.unsplash.com/photo-1467269204594-9661b134dd2b?q=80&w=1200&auto=format&fit=crop" data-fancybox="gallery">
                        <img src="https://images.unsplash.com/photo-1467269204594-9661b134dd2b?q=80&w=600&auto=format&fit=crop" alt="Kapadokya">
                    </a>

                    <a href="https://images.unsplash.com/photo-1552832230-c0197dd311b5?q=80&w=1200&auto=format&fit=crop" data-fancybox="gallery">
                        <img src="https://images.unsplash.com/photo-1552832230-c0197dd311b5?q=80&w=600&auto=format&fit=crop" alt="Roma">
                    </a>

                    <a href="https://images.unsplash.com/photo-1491557345352-5929e343eb89?q=80&w=1200&auto=format&fit=crop" data-fancybox="gallery">
                        <img src="https://images.unsplash.com/photo-1491557345352-5929e343eb89?q=80&w=600&auto=format&fit=crop" alt="Alsace">
                    </a>

                    <a href="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?q=80&w=1200&auto=format&fit=crop" data-fancybox="gallery">
                        <img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?q=80&w=600&auto=format&fit=crop" alt="Doğa">
                    </a>

                    <a href="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=1200&auto=format&fit=crop" data-fancybox="gallery">
                        <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=600&auto=format&fit=crop" alt="Deniz">
                    </a>

                    <a href="https://images.unsplash.com/photo-1512453979798-5ea266f8880c?q=80&w=1200&auto=format&fit=crop" data-fancybox="gallery">
                        <img src="https://images.unsplash.com/photo-1512453979798-5ea266f8880c?q=80&w=600&auto=format&fit=crop" alt="Şehir">
                    </a>
                </div>
            </div>

            <!-- NEWSLETTER -->
            <div class="footer-newsletter">
                <h5 class="title">Bülten Aboneliği</h5>

                <form>
                    <div class="input-wrap">
                        <input type="email" placeholder="E-posta Adresinizi Giriniz">
                        <button type="submit">→</button>
                    </div>
                </form>
            </div>

        </div>

        <!-- ALT -->
        <div class="footer-bottom">
            <p>© 2026 Vitour - Tüm hakları saklıdır</p>
        </div>
    </div>
</footer>