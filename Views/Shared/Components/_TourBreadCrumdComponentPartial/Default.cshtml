@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<Project3Vitour.SharedResource> SharedLocalizer
<section class="breadcumb-section"
         style="background-image: url('https://vitourwp.themesflat.co/wp-content/uploads/2024/05/page-title-e1715311291465.webp'); background-size: cover; background-position: center; position: relative;">
    <div class="tf-container">
        <div class="row">
            <div class="col-lg-12 center z-index1">
                <h1 class="title"> @SharedLocalizer["TourList_Banner"]</h1>
                <ul class="breadcumb-list flex-five">
                    <li><a href="/Home/Index">@SharedLocalizer["Home"]</a></li>
                    <li><span>@SharedLocalizer["Menu_Tours"]</span></li>
                </ul>
                <img class="bcrumb-ab" src="/vitour/assets/images/page/mask-bcrumb.png" alt="">
            </div>
        </div>

    </div>
</section>
