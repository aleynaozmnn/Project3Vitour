@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IViewLocalizer Localizer
@inject IHtmlLocalizer<Project3Vitour.SharedResource> SharedLocalizer
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vitour Admin</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* Senin TurList dosyasındaki CSS'lerin birebir aynısı */
        :root {
            --ink: #0f172a;
            --ink-60: #64748b;
            --surface: #ffffff;
            --surface-2: #f8fafc;
            --accent: #2563eb;
            --border: #e2e8f0;
            --font-head: 'Plus Jakarta Sans', sans-serif;
            --font-body: 'Inter', sans-serif;
            --transition: .25s cubic-bezier(.4,0,.2,1);
        }

        body {
            background: var(--surface-2) !important;
            font-family: var(--font-body) !important;
            margin: 0;
        }

        .ap-shell {
            display: grid;
            grid-template-columns: 280px 1fr;
            min-height: 100vh;
        }

        .ap-sidebar {
            background: #020617;
            position: sticky;
            top: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            z-index: 1000;
        }

        .ap-logo {
            padding: 32px 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .ap-logo-mark {
            width: 40px;
            height: 40px;
            background: var(--accent);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            box-shadow: 0 4px 12px rgba(37,99,235,0.3);
        }

        .ap-logo-text {
            font-family: var(--font-head);
            font-size: 18px;
            font-weight: 800;
            color: white;
            letter-spacing: -0.5px;
        }

        .ap-nav {
            flex: 1;
            padding: 24px 16px;
            overflow-y: auto;
        }

        .ap-nav-label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            color: #475569;
            text-transform: uppercase;
            padding: 0 12px;
            margin: 24px 0 8px;
        }

        .ap-nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border-radius: 10px;
            color: #94a3b8;
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
            transition: var(--transition);
            margin-bottom: 4px;
        }

            .ap-nav-item:hover {
                background: rgba(255,255,255,0.05);
                color: white;
            }

            .ap-nav-item.active {
                background: var(--accent);
                color: white;
                font-weight: 600;
            }

        .ap-sidebar-footer {
            padding: 20px;
            border-top: 1px solid rgba(255,255,255,0.05);
        }

        .ap-main {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .ap-topbar {
            background: var(--surface);
            height: 72px;
            padding: 0 40px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 99;
        }

        .ap-content {
            padding: 40px;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="ap-shell">
        <aside class="ap-sidebar">
            <div class="ap-logo">
                <div class="ap-logo-mark"><i class="bi bi-geo-alt-fill"></i></div>
                <div>
                    <div class="ap-logo-text">TRAVEL ADMIN</div>
                    <div style="font-size: 10px; color: #475569; letter-spacing: 1px;">MANAGEMENT PANEL</div>
                </div>
            </div>

            <nav class="ap-nav">
                <div class="ap-nav-label">@SharedLocalizer["GeneralMgmt"]</div>

                <a href="/AdminTour/Index" class="ap-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminTour" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i> @SharedLocalizer["Dashboard"]
                </a>

                <a href="/AdminTour/TourList" class="ap-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminTour" && ViewContext.RouteData.Values["Action"]?.ToString() == "TourList" ? "active" : "")">
                    <i class="bi bi-map"></i> @SharedLocalizer["Menu_Tours"]
                </a>

                <a href="/AdminTour/ReservationList" class="ap-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminTour" && ViewContext.RouteData.Values["Action"]?.ToString() == "ReservationList" ? "active" : "")">
                    <i class="bi bi-calendar-check"></i> @SharedLocalizer["Menu_Reservations"]
                </a>

               
                <a href="/Category/CreateCategory" class="ap-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Category" ? "active" : "")">
                    <i class="bi bi-tags"></i>@SharedLocalizer["CategoryMgmt"]
                </a>

              
                <a href="/Destination/Index" class="ap-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Destination" ? "active" : "")">
                    <i class="bi bi-geo-alt-fill"></i> @SharedLocalizer["DestMgmt"]
                </a>

                
                <a href="/Review/ReviewList" class="ap-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Review" ? "active" : "")">
                    <i class="bi bi-chat-left-text"></i>@SharedLocalizer["Reviews"]
                </a>

                @* Menü Grubu Başlığı (Gri küçük yazı) *@
                <div class="ap-nav-label">@SharedLocalizer["SystemManagement"]</div>

                @* Ayarlar Linki (Tıklanabilir menü öğesi) *@
                <a href="/AdminSettings/Index" class="ap-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminSettings" ? "active" : "")">
                    <i class="bi bi-gear-fill"></i> @SharedLocalizer["Settings"]
                </a>
            </nav>

            <div class="ap-sidebar-footer">
                <a href="/Account/Logout" class="ap-nav-item" style="margin-bottom: 0;">
                    <i class="bi bi-box-arrow-left"></i> @SharedLocalizer["Logout"]
                </a>
            </div>
        </aside>

        <div class="ap-main">
            <header class="ap-topbar d-flex justify-content-between align-items-center">
                <div style="font-size: 14px; font-weight: 500; color: var(--ink-60);">
                    Ana Sayfa / <span style="color: var(--ink);">@ViewData["Title"]</span>
                </div>
                <div class="pe-4">
                    <a href="/Language/Change?culture=tr-TR" class="btn btn-sm btn-outline-primary">TR</a>
                    <a href="/Language/Change?culture=en-US" class="btn btn-sm btn-outline-secondary">EN</a>
                </div>
            </header>

            <main class="ap-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>