@model List<Project3Vitour.Dtos.ReviewDtos.ResultReviewDto>
@{
    ViewData["Title"] = "Yorum Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var pendingReviews = Model.Where(x => !x.Status).ToList();
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <style>
        :root {
            --brand-blue: #4f46e5;
            --soft-blue: rgba(79, 70, 229, 0.05);
        }

        /* Üst Şerit Kartları */
        .scrolling-wrapper {
            display: flex;
            flex-wrap: nowrap;
            overflow-x: auto;
            gap: 16px;
            padding: 10px 4px 20px 4px;
        }

        .urgent-card {
            background: #fffbeb;
            border: 1px solid #fef3c7;
            border-radius: 20px;
            transition: all 0.3s ease;
            width: 350px;
            flex: 0 0 auto;
        }

        /* --- TABLO SÜTUNLARINI SABİTLEME --- */
        .res-table {
            table-layout: fixed !important;
            width: 100%;
        }

        .col-gezgin {
            width: 20%;
        }

        .col-yorum {
            width: 40%;
        }

        .col-puan {
            width: 15%;
        }

        .col-durum {
            width: 10%;
        }

        .col-islem {
            width: 15%;
        }

        .res-table tbody tr {
            transition: all 0.2s ease;
            cursor: pointer;
            border-bottom: 1px solid #f1f5f9;
        }

            .res-table tbody tr:hover {
                background-color: var(--soft-blue) !important;
                box-shadow: inset 4px 0 0 var(--brand-blue);
            }

        .user-avatar {
            width: 40px;
            height: 40px;
            background: #eef2ff;
            color: var(--brand-blue);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            border: 1px solid #e0e7ff;
        }

        .review-content {
            font-size: 13px;
            color: #334155;
            line-height: 1.5;
            margin-bottom: 6px;
        }

        .tour-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #fff7ed;
            color: #c2410c;
            padding: 3px 12px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 700;
            border: 1px solid #ffedd5;
        }
    </style>
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-4">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary text-white p-3 rounded-4"><i class="bi bi-chat-left-quote fs-4"></i></div>
                <div>
                    <h4 class="fw-bold mb-0">Yorum Yönetimi</h4>
                    <span class="text-muted small">@Model.Count toplam yorum listeleniyor</span>
                </div>
            </div>
            <div class="d-flex gap-4">
                <div class="text-center"><div class="small text-muted fw-bold">ONAYLI</div><div class="h5 mb-0 fw-bold">@(Model.Count - pendingReviews.Count)</div></div>
                <div class="text-center"><div class="small text-muted fw-bold text-warning">BEKLEYEN</div><div class="h5 mb-0 fw-bold text-warning">@pendingReviews.Count</div></div>
            </div>
        </div>
    </div>

    @if (pendingReviews.Any())
    {
        <div class="scrolling-wrapper mb-4">
            @foreach (var p in pendingReviews)
            {
                <div class="card urgent-card shadow-sm p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="fw-bold">@p.NameSurname</span>
                        <span class="badge bg-warning text-dark">@p.Score/5</span>
                    </div>
                    <p class="small text-muted" style="height: 40px; overflow: hidden;">@p.Detail</p>
                    <div class="d-flex gap-2">
                        <a href="/Review/ApproveReview/@p.ReviewId" class="btn btn-sm btn-primary w-100 rounded-3">Hızlı Onayla</a>
                        <button onclick="deleteReview('@p.ReviewId')" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </div>
                </div>
            }
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden" style="background: white;">
        <div class="table-responsive">
            <table class="table res-table m-0 align-middle">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-4 py-3 col-gezgin">GEZGİN</th>
                        <th class="py-3 col-yorum">YORUM VE TUR BİLGİSİ</th>
                        <th class="text-center py-3 col-puan">PUAN</th>
                        <th class="text-center py-3 col-durum">DURUM</th>
                        <th class="text-end pe-4 py-3 col-islem">İŞLEMLER</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="user-avatar">@item.NameSurname.Substring(0, 1).ToUpper()</div>
                                    <div>
                                        <div class="fw-bold small text-dark">@item.NameSurname</div>
                                        <div class="text-muted" style="font-size: 10px;">@item.ReviewDate.ToString("dd.MM.yyyy")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="review-content">
                                    @(item.Detail.Length > 85 ? item.Detail.Substring(0, 82) + "..." : item.Detail)
                                    @if (item.Detail.Length > 85)
                                    {
                                        <button onclick="showFullReview('@item.NameSurname', '@item.Detail')" class="btn btn-sm btn-link p-0 text-primary fw-bold ms-1" style="font-size: 11px; text-decoration: none;">[Detay]</button>
                                    }
                                </div>
                                <div class="tour-badge"><i class="bi bi-geo-alt-fill me-1"></i> @item.Description</div>
                            </td>
                            <td class="text-center text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= item.Score ? "bi-star-fill" : "bi-star")" style="font-size: 11px;"></i>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge @(item.Status ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") rounded-pill px-3 py-2" style="font-size: 10px;">
                                    @(item.Status ? "Yayında" : "Bekliyor")
                                </span>
                            </td>
                            <td class="pe-4 text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    @if (!item.Status)
                                    {
                                        <a href="/Review/ApproveReview/@item.ReviewId" class="btn btn-sm btn-light text-success border"><i class="bi bi-check2-circle fs-5"></i></a>
                                    }
                                    <button onclick="deleteReview('@item.ReviewId')" class="btn btn-sm btn-light text-danger border"><i class="bi bi-trash3 fs-5"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function showFullReview(user, text) {
            Swal.fire({ title: user, text: text, icon: 'info', confirmButtonColor: '#4f46e5' });
        }
        function deleteReview(id) {
            Swal.fire({
                title: 'Emin misiniz?',
                text: "Bu yorum sistemden silinecek!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#4f46e5',
                cancelButtonColor: '#ef4444',
                confirmButtonText: 'Evet, sil!',
                cancelButtonText: 'Vazgeç'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = "/Review/DeleteReview/" + id;
                }
            })
        }
    </script>
}